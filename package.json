{
  "name": "@tastic/physics",
  "version": "0.1.3",
  "description": "2D arcade-game physics: circle/rect/rounded-rect collision and reflection, friction, gravity wells, springs, and velocity clamping — built on @tastic/core's Vec2",
  "keywords": [
    "react-native",
    "expo",
    "physics",
    "collision",
    "2d",
    "vec2",
    "game-physics"
  ],
  "homepage": "https://github.com/jayrdeaton/game-physics#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/game-physics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/game-physics.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.8",
    "@infinitetoken/jest-config": "^0.2.1",
    "@infinitetoken/tsconfig": "^0.3.0",
    "@tastic/core": "^0.1.5",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@tastic/core": ">=0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
